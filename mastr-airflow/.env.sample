# Copy to .env and fill in locally. Do not commit real credentials.
# cp .env.sample .env

# --- Airflow metadata / UI ---
POSTGRES_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=change-me-generate-with-python-fernet
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Host paths mounted into containers (read-only) ---
# Prefer keyless ADC + impersonation for dedicated-project runs.
# GCP_KEYS_HOST_PATH is only needed if Compose still mounts a key directory.
GCP_KEYS_HOST_PATH=/home/YOUR_USER/.gcp_keys
DBT_PROFILES_HOST_PATH=/home/YOUR_USER/.dbt

# --- MaStR pipeline settings (same names as mastr-data-pipeline/.env) ---
GCP_PROJECT_ID=mastr-project-1126
GCS_BUCKET=mastr-project-1126-bronze
BQ_DATASET=mastr_raw
BQ_LOCATION=europe-west3

# Compose currently sets GOOGLE_APPLICATION_CREDENTIALS to a mounted key path.
# For dedicated-project Phase C+, prefer keyless impersonation of
# mastr-runtime@mastr-project-1126.iam.gserviceaccount.com and avoid bootcamp keys.
# Do not create or modify JSON key files under ~/.gcp_keys/.
