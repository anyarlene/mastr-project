# Copy to terraform.tfvars (gitignored) for local use.
# cp terraform.tfvars.example terraform.tfvars

project_id = "mastr-project-1126"
region     = "europe-west3"

bronze_bucket_name = "mastr-project-1126-bronze"

runtime_service_account_id = "mastr-runtime"

bigquery_datasets = [
  "mastr_raw",
  "mastr_staging",
  "mastr_intermediate",
  "mastr_marts",
]

# Pre-existing state bucket — not created or managed by this stack.
tfstate_bucket_name = "mastr-project-1126-tfstate"
