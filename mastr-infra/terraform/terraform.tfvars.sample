# Copy to terraform.tfvars (gitignored) for local use.
# cp terraform.tfvars.sample terraform.tfvars

project_id = "your-gcp-project-id"
region     = "europe-west3"

bronze_bucket_name = "your-bronze-bucket-name"

runtime_service_account_id = "mastr-runtime"

bigquery_datasets = [
  "mastr_raw",
  "mastr_staging",
  "mastr_intermediate",
  "mastr_marts",
]

# Pre-existing state bucket — not created or managed by this stack.
tfstate_bucket_name = "your-tfstate-bucket-name"
