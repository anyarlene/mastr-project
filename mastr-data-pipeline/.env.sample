# Copy to .env and fill in locally. Do not commit real credentials.
# cp .env.sample .env

# Required destinations (dedicated MaStR project)
GCP_PROJECT_ID=mastr-project-1126
GCS_BUCKET=mastr-project-1126-bronze
MASTR_RAW_DIR=/absolute/path/to/mastr-project/mastr-data-pipeline/data/raw
BQ_DATASET=mastr_raw
BQ_LOCATION=europe-west3

# Authentication (keyless preferred for dedicated project):
# Leave GOOGLE_APPLICATION_CREDENTIALS unset/empty and use Application Default
# Credentials with service-account impersonation of:
#   mastr-runtime@mastr-project-1126.iam.gserviceaccount.com
# Do not point this at a bootcamp JSON key for dedicated-project runs.
# GOOGLE_APPLICATION_CREDENTIALS=
