# Optional local overrides. Copy to .env and adjust paths for your user.
# cp .env.example .env

# BigQuery project (defaults to mastr-project-1126 if unset)
GCP_PROJECT_ID=mastr-project-1126

# Point at the MaStR-specific ADC file (not a service-account private key).
# Replace YOUR_USER with your Linux username.
# This path only selects which credentials file ADC loads; it does not create a
# separate Google identity or a separate refresh-token grant.
GOOGLE_APPLICATION_CREDENTIALS=/home/YOUR_USER/.config/gcloud/mastr/application_default_credentials.json
