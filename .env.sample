# Copy to .env and fill in locally. Do not commit real credentials.
# cp .env.sample .env

# --- Airflow metadata / UI ---
POSTGRES_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=change-me-generate-with-python-fernet
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Host paths mounted into containers (read-only for credentials) ---
# Keep these equal to the paths already used by ~/.dbt/profiles.yml
GCP_KEYS_HOST_PATH=/home/YOUR_USER/.gcp_keys
DBT_PROFILES_HOST_PATH=/home/YOUR_USER/.dbt

# --- MaStR pipeline settings (same names as mastr-data-pipeline/.env) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-bronze-bucket
BQ_DATASET=mastr_raw
BQ_LOCATION=europe-west3
# GOOGLE_APPLICATION_CREDENTIALS is set inside Compose to the container path
# /home/YOUR_USER/.gcp_keys/dbt-service-account.json (keyfile mounted read-only).
