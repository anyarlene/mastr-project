//// MaStR star schema (Gold / Marts) — dbdiagram.io compatible
////
//// Pipeline path:
////   4 CSVs → GCS Bronze → 4 BigQuery Raw tables (mastr_raw)
////         → 4 Staging views (mastr_staging)
////         → int_mastr_units (mastr_intermediate; UNION ALL + classification)
////         → Gold dims / facts / mart (mastr_marts)
////
//// Dataset: mastr_marts (europe-west3). Materialization: table (unless noted).
//// This file documents persisted Gold tables only.
////
//// Not diagrammed (ephemeral / intermediate helpers):
////   - complete_snapshots (ephemeral) — completeness filter for dims/mart
////   - cdc_eligible_snapshots (ephemeral) — complete + export_scope=all_statuses
////   - int_mastr_unit_cdc (view in mastr_intermediate) — source of CDC fact
////
//// Snapshot semantics:
////   A snapshot_date is complete when all four expected CSVs match
////   seed_snapshot_expectations and Raw/Staging/Intermediate counts align.
////   mart_municipality_capacity uses only max(complete snapshot_date).
////
//// CDC semantics (fct_mastr_unit_changes):
////   Compares consecutive CDC-eligible complete snapshots (all_statuses only;
////   legacy_mixed_filters dates such as 2026-11-09 are never endpoints).
////   change_type ∈ {INSERT, UPDATE, DELETE_CANDIDATE}; UNCHANGED excluded.
////   DELETE_CANDIDATE = present in earlier snapshot, absent in later — not a
////   confirmed physical deletion. Observation dates only (no valid_from/to).
////   Not SCD Type 2. With a single eligible snapshot, the fact is empty.
////
//// SCD Type 2 (dbt snapshots) is deferred and not represented here.

Table dim_municipality {
  municipality_id varchar [pk, note: 'AGS natural key (8-digit)']
  municipality_name varchar [not null]
  district varchar
  federal_state varchar

  Note: '''
  Materialized table. Grain: one row per municipality_id ever observed in Intermediate.
  Attributes chosen deterministically (prefer latest complete snapshot, then
  latest snapshot_date, then stable tie-breaks).
  '''
}

Table dim_energy_source {
  energy_source_id int [pk, note: 'Surrogate key from seed_energy_sources']
  energy_source_code varchar [unique, not null, note: 'wind | solar | biomass | battery | hydrogen_storage | other_storage | unknown']
  energy_source_label varchar
  energy_source_group varchar [not null, note: 'generation | storage | unknown']

  Note: 'Materialized table. English-only reference dimension from seed_energy_sources.'
}

Table dim_status {
  status_id int [pk, note: 'Surrogate key from seed_statuses']
  status_code varchar [unique, not null, note: 'operational | planned | decommissioned | temporarily_decommissioned | unknown']
  status_label varchar
  is_operational boolean [not null, note: 'True only for operational']

  Note: 'Materialized table. English-only reference dimension from seed_statuses.'
}

Table fct_mastr_units {
  snapshot_date date [not null]
  unit_id varchar [not null]

  municipality_id varchar [not null]
  energy_source_id int [not null]
  status_id int [not null]

  unit_name varchar
  storage_id varchar
  is_operational boolean [not null]

  generation_power_kw numeric [note: 'Net kW; generation units only (else null)']
  storage_power_kw numeric [note: 'Net kW; storage units only (else null)']
  storage_capacity_kwh numeric [note: 'Usable kWh; storage only (else null)']
  gross_power_kw numeric [note: 'Audit / nameplate — not used for municipality headlines']

  commissioning_date date
  planned_commissioning_date date
  decommissioned_date date
  last_updated_at date [note: 'Parsed MaStR date field; not a timestamp']

  source_file varchar [not null]
  ingested_at timestamp [not null, note: 'UTC Raw load timestamp']

  indexes {
    (snapshot_date, unit_id) [pk]
  }

  Note: '''
  Materialized table. Grain: one installation unit per snapshot_date.
  Built from int_mastr_units joined to the three dims.
  Unknown energy classifications are retained for investigation.
  dbt relationship tests enforce FKs to dim_municipality, dim_energy_source, dim_status.
  '''
}

Table mart_municipality_capacity {
  municipality_id varchar [pk]
  municipality_name varchar
  district varchar
  federal_state varchar
  snapshot_date date [not null, note: 'Latest complete snapshot only']

  operational_generation_power_kw numeric [not null]
  operational_wind_power_kw numeric
  operational_solar_power_kw numeric
  operational_biomass_power_kw numeric

  operational_storage_power_kw numeric [not null]
  operational_storage_capacity_kwh numeric [not null]
  operational_battery_power_kw numeric
  operational_battery_capacity_kwh numeric
  operational_hydrogen_storage_power_kw numeric
  operational_hydrogen_storage_capacity_kwh numeric

  operational_generation_unit_count int
  operational_storage_unit_count int

  Note: '''
  Materialized table. Grain: one row per municipality at the latest complete snapshot_date.
  All dim_municipality rows are retained (left join); municipalities with no
  operational generation/storage units show zero measures.
  Operational installations only; unknown energy_source_group excluded from totals.
  Generation kW, storage kW, and storage kWh remain separate.
  '''
}

Table fct_mastr_unit_changes {
  from_snapshot_date date [not null, note: 'Earlier CDC-eligible snapshot']
  to_snapshot_date date [not null, note: 'Later CDC-eligible snapshot']
  unit_id varchar [not null]
  source_file varchar [not null, note: 'wind.csv | solar.csv | biomass.csv | battery.csv']
  change_type varchar [not null, note: 'INSERT | UPDATE | DELETE_CANDIDATE']

  before_status_code varchar [note: 'Null on INSERT']
  after_status_code varchar [note: 'Null on DELETE_CANDIDATE']
  before_net_power_kw numeric
  after_net_power_kw numeric
  before_storage_capacity_kwh numeric
  after_storage_capacity_kwh numeric
  before_municipality_id varchar [note: 'Null on INSERT; AGS when present']
  after_municipality_id varchar [note: 'Null on DELETE_CANDIDATE; AGS when present']

  indexes {
    (from_snapshot_date, to_snapshot_date, unit_id) [pk]
  }

  Note: '''
  Materialized table. Selects non-UNCHANGED rows from int_mastr_unit_cdc.
  Grain: (from_snapshot_date, to_snapshot_date, unit_id).
  Tracked attributes: status_code, net_power_kw, storage_capacity_kwh, municipality_id.
  No dbt relationship tests to dims (status/municipality stored as codes/IDs that
  may be null depending on change_type). Not SCD Type 2.
  '''
}

Ref: fct_mastr_units.municipality_id > dim_municipality.municipality_id
Ref: fct_mastr_units.energy_source_id > dim_energy_source.energy_source_id
Ref: fct_mastr_units.status_id > dim_status.status_id
Ref: mart_municipality_capacity.municipality_id > dim_municipality.municipality_id
