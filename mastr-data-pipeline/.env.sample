# Copy to .env and fill in locally. Do not commit real credentials.
# cp .env.sample .env

# Required destinations (use your dedicated MaStR GCP project values)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-bronze-bucket-name
MASTR_RAW_DIR=/absolute/path/to/mastr-project/mastr-data-pipeline/data/raw
BQ_DATASET=mastr_raw
BQ_LOCATION=europe-west3

# Authentication (keyless preferred for dedicated project):
# Leave GOOGLE_APPLICATION_CREDENTIALS unset/empty and use Application Default
# Credentials with service-account impersonation of your runtime SA, e.g.:
#   RUNTIME_SA@YOUR_PROJECT.iam.gserviceaccount.com
# Do not point this at unrelated training/bootcamp JSON keys for dedicated runs.
# GOOGLE_APPLICATION_CREDENTIALS=
