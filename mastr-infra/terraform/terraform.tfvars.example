# Copy to terraform.tfvars (gitignored) for local use.
# cp terraform.tfvars.example terraform.tfvars

project_id = "your-gcp-project-id"
region     = "europe-west3"

bronze_bucket_name = "your-bronze-bucket-name"

dbt_service_account_id           = "dbt-service-account"
dbt_service_account_display_name = "dbt Service Account"

bigquery_datasets = [
  "mastr_raw",
  "mastr_staging",
  "mastr_intermediate",
  "mastr_marts",
]

# Dedicated state bucket — create manually in a later step before remote init.
tfstate_bucket_name = "wagon-mastr-tfstate-anyarlene-2399"
