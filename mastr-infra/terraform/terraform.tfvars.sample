# Copy to terraform.tfvars (gitignored) for local use.
# cp terraform.tfvars.sample terraform.tfvars

project_id = "your-gcp-project-id"
region     = "europe-west3"

bronze_bucket_name = "your-bronze-bucket-name"

runtime_service_account_id = "mastr-runtime"

bigquery_datasets = [
  "mastr_raw",
  "mastr_staging",
  "mastr_intermediate",
  "mastr_marts",
]

# Informational only: documents / outputs the state bucket name.
# Does NOT configure the GCS backend — pass the same name at init via
# `-backend-config=bucket=...` or a local `backend.hcl` (see README).
tfstate_bucket_name = "your-tfstate-bucket-name"
