# Copy to .env and fill in locally. Do not commit real credentials.
# cp .env.sample .env

# --- Airflow metadata / UI ---
POSTGRES_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=change-me-generate-with-python-fernet
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Host paths mounted into containers (read-only) ---
# MaStR-specific ADC file (recommended). Replace YOUR_USER with your Linux username.
# This path only isolates which file Compose mounts; it is not a separate Google
# identity or a separate refresh-token grant.
GCP_ADC_HOST_PATH=/home/YOUR_USER/.config/gcloud/mastr/application_default_credentials.json
DBT_PROFILES_HOST_PATH=/home/YOUR_USER/.dbt

# --- MaStR pipeline settings (same names as mastr-data-pipeline/.env) ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-bronze-bucket-name
BQ_DATASET=mastr_raw
BQ_LOCATION=europe-west3

# Authentication (keyless):
# - Do NOT set GOOGLE_APPLICATION_CREDENTIALS (leave unset so the mounted ADC is used).
# - Do NOT mount or create service-account JSON private keys.
# - Prefer ~/.config/gcloud/mastr/application_default_credentials.json for MaStR.
# - `gcloud auth application-default login` writes to the *default* ADC location
#   (~/.config/gcloud/application_default_credentials.json) and may replace any
#   credentials already stored there. Do not run it if you need to keep an
#   existing default ADC unchanged.
# - If you already have a suitable already-impersonated ADC, copy that file into
#   the MaStR path above, then point GCP_ADC_HOST_PATH at the copy.
# - Use an already-impersonated ADC and omit impersonate_service_account from the
#   dbt profile (avoids double impersonation). See pipeline dbt/profiles.yml.sample.
# - Python ingest/load and dbt share that same mounted ADC identity.
