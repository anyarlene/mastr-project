# Example dbt profile for MaStR. Merge the `mastr` block into ~/.dbt/profiles.yml.
# Do not replace existing profiles (e.g. dbt_lewagon).
#
# Requires GCP_PROJECT_ID in the environment (from the repo .env).

mastr:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: mastr_staging
      location: europe-west3
      keyfile: /home/YOUR_USER/.gcp_keys/dbt-service-account.json
      threads: 4
      job_execution_timeout_seconds: 300
      priority: interactive
      job_retries: 1
